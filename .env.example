# App server
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Security
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_EXPIRY=15m
REFRESH_EXPIRY_MS=604800000

# Database
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/WalletDB

# Email verification
APP_BASE_URL=http://localhost:3000
EMAIL_FROM=no-reply@wallet.local
EMAIL_VERIFY_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true

# SMTP (optional for local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Rate limiting (optional overrides)
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=120
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_MAX=15
WALLET_RATE_WINDOW_MS=60000
WALLET_RATE_MAX=120

# Auth policy knobs (optional overrides)
MIN_PASSWORD_LENGTH=8
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=900000
LOGIN_MAX_ATTEMPTS=5

# Admin limits (optional overrides)
ADMIN_RATE_WINDOW_MS=60000
ADMIN_RATE_MAX=240
ADMIN_MAX_PAGE_SIZE=200

# Wallet and jobs (optional overrides)
MAX_WITHDRAW_PER_DAY=25000
WITHDRAW_MEDIUM_OTP=123456
# Keep true in production. For local testing, set false to bypass KYC gate.
REQUIRE_KYC_FOR_WITHDRAWAL=true
# Force OTP challenge for every withdrawal regardless of risk scoring.
FORCE_WITHDRAW_OTP=false
DUMMY_ESCROW_ACCOUNT_ID=dummy_escrow_account
DUMMY_ESCROW_OWNER_NAME=Dummy Escrow Account
WALLET_JOB_INTERVAL_MS=300000
ESCROW_SYNC_INTERVAL_MS=86400000

# Admin bootstrap/allowlist (optional)
# Comma-separated identifiers (typically emails) that should get admin role.
ADMIN_IDENTIFIERS=
